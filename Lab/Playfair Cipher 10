#include <stdio.h>
#include <string.h>
#include <ctype.h>

char a[5][5] = {
    {'M','F','H','I','K'},
    {'U','N','O','P','Q'},
    {'Z','V','W','X','Y'},
    {'E','L','A','R','G'},
    {'D','S','T','B','C'}
};

int main() {
    char s[] = "MUST SEE YOU OVER CADOGAN WEST";
    char p[100], x, y;
    int i, j, r1, c1, r2, c2, n = 0;

    for (i = 0; s[i]; i++)
        if (isalpha(s[i]))
            p[n++] = toupper(s[i]);

    if (n % 2) p[n++] = 'X';

    for (i = 0; i < n; i += 2) {
        x = p[i];
        y = p[i + 1];

        for (r1 = 0; r1 < 5; r1++)
            for (c1 = 0; c1 < 5; c1++)
                if (a[r1][c1] == x) goto found1;

        found1:
        for (r2 = 0; r2 < 5; r2++)
            for (c2 = 0; c2 < 5; c2++)
                if (a[r2][c2] == y) goto found2;

        found2:
        if (r1 == r2) {
            x = a[r1][(c1 + 1) % 5];
            y = a[r2][(c2 + 1) % 5];
        } else if (c1 == c2) {
            x = a[(r1 + 1) % 5][c1];
            y = a[(r2 + 1) % 5][c2];
        } else {
            x = a[r1][c2];
            y = a[r2][c1];
        }

        printf("%c%c ", x, y);
    }

    return 0;
}
