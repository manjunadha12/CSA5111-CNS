#include <stdio.h>
#include <math.h>
int main() {
    double keys, unique;
    keys = 1;

    for (int i = 1; i <= 25; i++)
        keys *= i;

    unique = keys / (25 * 2 * 2);

    printf("Total keys = 25! = %.3e\n", keys);
    printf("Effectively unique keys = %.3e\n", unique);
    printf("Approximate power of 2 = 2^%.0f\n",
           log2(unique));

    return 0;
}
